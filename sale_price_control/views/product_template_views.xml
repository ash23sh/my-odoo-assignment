<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit Product Template Form View:
        This record extends the standard product form to include price control fields.
    -->
    <record id="product_template_form_view_inherit_price" model="ir.ui.view">
        <field name="name">product.template.form.inherit.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!--
                XPath targeting the price container div to ensure proper UI alignment.
                New fields are inserted immediately after the standard Sales Price field.
            -->
            <xpath expr="//div[@name='standard_price_uom']" position="after">

                <!--
                    Min/Max Price Fields:
                    - widget="monetary": Displays the appropriate currency symbol.
                    - groups: Restricts access so only 'Sales Managers' can view or edit these fields.
                -->
                <field name="min_sale_price"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       groups="sales_team.group_sale_manager"/>

                <field name="max_sale_price"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       groups="sales_team.group_sale_manager"/>
            </xpath>

        </field>
    </record>
</odoo>