<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view for Sale Tags with inline editing support -->
    <record id="view_sale_tag_tree" model="ir.ui.view">
        <field name="name">sale.tag.tree</field>
        <field name="model">sale.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- Window Action to open Sale Tags view -->
    <record id="action_sale_tag" model="ir.actions.act_window">
        <field name="name">Order Tags</field>
        <field name="res_model">sale.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu item located under Sales -> Orders menu -->
    <menuitem id="menu_sale_tag"
              name="Tags"
              parent="sale.menu_sale_order"
              action="action_sale_tag"
              sequence="40"/>

</odoo>